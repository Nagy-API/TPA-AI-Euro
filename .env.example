# Example variable names ONLY, no real secrets.
NODE_ENV=development
PORT=3000
TPA_BACKEND_BASE_URL=http://localhost:4000
# LLM_API_KEY=               # Fill only in local .env or secret manager; NEVER commit.
# LLM_MODEL=                 # Decide after eval + privacy review.

# Demo only: ENABLE_DEMO_AUTH must be true to run fake sessions, and NODE_ENV != production.
ENABLE_DEMO_AUTH=true
# fixture = DEFAULT: offline non-AI keyword selector.
# ollama = existing V0.4 local inference in verified demo mode.
# ollama-v05 = experimental conversation with direct local Ollama.
# hub = experimental conversation via POST http://127.0.0.1:8000/v1/inference.
# claude = requires EXPLICIT ALLOW_PAID_LLM=true plus API credentials; do not use until approved.
DEMO_INTENT_MODE=fixture
OLLAMA_MODEL=qwen3:4b-instruct
LOCAL_AI_HUB_PROFILE=local-instruct
ALLOW_PAID_LLM=false
# Synthetic V0.6 evaluator only. Leave blank until explicitly approved.
OPENAI_API_KEY=
OPENAI_EVAL_MANIFEST_SHA256=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Never enter real user credentials or patient information.

# Synthetic WhatsApp Cloud API only. Copy to the ignored .env.whatsapp for this listener.
ENABLE_WHATSAPP_TEST=false
WHATSAPP_PORT=3010
# hub or ollama-v05. DEMO_INTENT_MODE continues to control the separate Web Demo.
WHATSAPP_INTENT_MODE=hub
WHATSAPP_GRAPH_VERSION=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# International digits only, with country code and without +. Up to five comma-separated recipients.
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
